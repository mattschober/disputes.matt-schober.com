# Environment variables for the disputes portal build.
# In production these are stored in Doppler and injected via `doppler run`.
# For quick local testing you may copy this to `.env` and `export` them,
# but prefer Doppler so secrets never touch disk.

# --- Required for live data ---------------------------------------------------
# HubSpot Private App access token with the `crm.objects.deals.read` scope
# (and optionally `crm.pipelines.read` for live stage labels).
# Stored in Doppler as HUBSPOT_SERVICE_KEY.
# Leave unset to build from mock data. (HUBSPOT_TOKEN also accepted as fallback.)
HUBSPOT_SERVICE_KEY=

# --- Optional overrides -------------------------------------------------------
# HUBSPOT_PIPELINE_ID=default           # "Disputes" deal pipeline. The consulting
#                                       # pipeline (1310445295) must never be used.
# PUBLISH_REQUIRE_MARKER=false          # true => only publish deals flagged opt-in
# PUBLISH_MARKER_PROPERTY=publish_to_portal
# PUBLISH_MARKER_VALUE=true
# PUBLISH_DESCRIPTIONS=false            # true => publish the deal description
# PUBLISH_AMOUNTS=false                 # true => publish the deal amount
# REFERENCE_PREFIX=MS

# SITE_BRAND=Matt Schober
# SITE_TITLE=Legal Disputes Portal
# SITE_DOMAIN=disputes.matt-schober.com
# SITE_CONTACT_EMAIL=legal@matt-schober.com
# SITE_TAGLINE=A public record of legal matters and disputes, maintained for transparency.
